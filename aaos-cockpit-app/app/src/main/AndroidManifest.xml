<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <!-- required="false": REPLAY_FILE detection backend mode must still install and run
         on a no-camera CarSky emulator image; LIVE_CAMERA mode is unavailable there. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-permission android:name="android.car.permission.CONTROL_CAR_CLIMATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Without this, PackageManager's Android 11+ visibility filtering hides every
         installed TextToSpeech engine from this app's queryIntentServices() lookup,
         so TextToSpeech.onInit() silently reports SUCCESS but speak() fails with
         "not bound to TTS engine" even when a real engine is installed and set as
         the device default. Confirmed on-device 2026-08-01. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.VitalGuard">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Owns the live TRIGGER_ALERT receiver (see VitalGuardMonitorService); a
             manifest-declared receiver for this implicit action never fires on API 26+
             (confirmed on-device: "Background execution not allowed"), so it isn't declared
             here — the dynamic registration inside the service is the only real path. -->
        <service
            android:name=".VitalGuardMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Driver drowsiness monitoring and multi-sensory alert intervention" />
        </service>

        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- ADB-triggerable at runtime so GATEWAY_MODE can flip REAL<->FAKE in seconds
             during a live demo without a rebuild: see aaos-cockpit-app/CLAUDE.md. -->
        <receiver
            android:name=".GatewayModeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.vitalguard.ai.SET_GATEWAY_MODE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
